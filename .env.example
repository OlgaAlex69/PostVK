# Render: эти переменные нужно задать в Dashboard → Environment
# Не забудьте убрать кавычки — Render подставляет значения как есть
#
# === ProxyAPI (AI генерация) ===
API_KEY=sk-your-api-key-here
API_URL=https://api.proxyapi.ru/openai/v1/chat/completions
MODEL=gpt-5.4-mini
DEFAULT_TONE=дружелюбный, искренний, с лёгким юмором

# === ВКонтакте ===
VK_ACCESS_TOKEN=vk1.a.your-vk-token-here
VK_OWNER_ID=-12345678
